<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<title>4A4B 猜數字對戰</title>

<style>
* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

body {
    margin: 0;
    min-height: 100vh;
    font-family: -apple-system, BlinkMacSystemFont, "Noto Sans TC", sans-serif;
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: #222;
}

.container {
    width: 100%;
    max-width: 500px;
    margin: auto;
    padding: 20px 15px 40px;
}

.card {
    background: rgba(255,255,255,0.96);
    border-radius: 25px;
    padding: 22px;
    margin-bottom: 15px;
    box-shadow: 0 12px 35px rgba(0,0,0,.18);
}

h1 {
    text-align: center;
    margin: 5px 0 8px;
    font-size: 30px;
}

.subtitle {
    text-align: center;
    color: #777;
    margin-bottom: 20px;
}

input {
    width: 100%;
    height: 52px;
    border: 2px solid #ddd;
    border-radius: 14px;
    padding: 0 15px;
    font-size: 20px;
    outline: none;
    margin-bottom: 12px;
}

input:focus {
    border-color: #667eea;
}

button {
    width: 100%;
    border: none;
    border-radius: 15px;
    height: 52px;
    font-size: 18px;
    font-weight: bold;
    background: #667eea;
    color: white;
    margin-top: 8px;
    cursor: pointer;
}

button:active {
    transform: scale(.97);
}

.secondary {
    background: #eee;
    color: #444;
}

.danger {
    background: #ff5c5c;
}

.hidden {
    display: none !important;
}

.room-code {
    font-size: 32px;
    font-weight: bold;
    text-align: center;
    letter-spacing: 6px;
    color: #667eea;
    margin: 10px 0;
}

.status {
    text-align: center;
    padding: 12px;
    border-radius: 12px;
    background: #f1f3ff;
    margin-bottom: 15px;
    font-weight: bold;
}

.secret {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin: 15px 0;
}

.secret input {
    width: 55px;
    height: 60px;
    text-align: center;
    padding: 0;
    font-size: 28px;
    font-weight: bold;
}

.guess-box {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin: 15px 0;
}

.guess-box input {
    width: 55px;
    height: 60px;
    text-align: center;
    padding: 0;
    font-size: 28px;
    font-weight: bold;
}

.result {
    padding: 12px;
    border-radius: 12px;
    background: #f7f7f7;
    margin-bottom: 8px;
    display: flex;
    justify-content: space-between;
}

.A {
    color: #e53935;
    font-weight: bold;
}

.B {
    color: #1976d2;
    font-weight: bold;
}

.player {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid #eee;
}

.win {
    text-align: center;
    font-size: 28px;
    font-weight: bold;
    color: #e53935;
    padding: 20px 0;
}

.small {
    font-size: 14px;
    color: #888;
    text-align: center;
}

.error {
    color: #e53935;
    text-align: center;
    margin-top: 10px;
}
</style>
</head>

<body>

<div class="container">

    <!-- 首頁 -->
    <div id="home" class="card">

        <h1>🔢 4A4B</h1>

        <div class="subtitle">
            四位數雙人猜數字對戰
        </div>

        <input
            id="roomInput"
            type="text"
            maxlength="6"
            placeholder="輸入房間碼"
            autocomplete="off"
        >

        <button onclick="createRoom()">
            🎮 建立新房間
        </button>

        <button class="secondary" onclick="joinRoom()">
            🚪 加入房間
        </button>

        <div id="homeError" class="error"></div>

        <p class="small">
            兩支手機輸入相同房間碼即可對戰
        </p>

    </div>


    <!-- 房間等待 -->
    <div id="waiting" class="card hidden">

        <h1>🎮 等待玩家</h1>

        <p class="small">房間碼</p>

        <div id="roomCodeDisplay" class="room-code">
            ------
        </div>

        <div class="status">
            <span id="playerCount">等待另一位玩家加入...</span>
        </div>

        <p class="small">
            把房間碼給另一位玩家<br>
            對方用手機輸入這組房間碼即可
        </p>

        <button class="secondary" onclick="copyRoomCode()">
            📋 複製房間碼
        </button>

        <button class="danger" onclick="location.reload()">
            離開房間
        </button>

    </div>


    <!-- 設定秘密數字 -->
    <div id="setup" class="card hidden">

        <h1>🔐 設定秘密數字</h1>

        <div class="status">
            請設定你的 4 位數秘密答案
        </div>

        <div class="secret">
            <input maxlength="1" inputmode="numeric">
            <input maxlength="1" inputmode="numeric">
            <input maxlength="1" inputmode="numeric">
            <input maxlength="1" inputmode="numeric">
        </div>

        <button onclick="setSecret()">
            🔒 確認秘密數字
        </button>

        <div id="secretError" class="error"></div>

    </div>


    <!-- 遊戲 -->
    <div id="game" class="hidden">

        <div class="card">

            <h1>⚔️ 對戰中</h1>

            <div id="gameStatus" class="status">
                等待對方...
            </div>

            <div class="player">
                <span>你</span>
                <b id="meReady">❌</b>
            </div>

            <div class="player">
                <span>對方</span>
                <b id="opponentReady">❌</b>
            </div>

        </div>


        <div class="card">

            <h2>🎯 猜對方</h2>

            <div class="guess-box">
                <input maxlength="1" inputmode="numeric">
                <input maxlength="1" inputmode="numeric">
                <input maxlength="1" inputmode="numeric">
                <input maxlength="1" inputmode="numeric">
            </div>

            <button id="guessButton" onclick="makeGuess()">
                猜！
            </button>

            <div id="guessError" class="error"></div>

        </div>


        <div class="card">

            <h2>📜 猜測紀錄</h2>

            <div id="history">
                <p class="small">還沒有猜測紀錄</p>
            </div>

        </div>

    </div>


    <!-- 勝利 -->
    <div id="win" class="card hidden">

        <div class="win">
            🎉 你贏了！
        </div>

        <p id="winText" class="small"></p>

        <button onclick="location.reload()">
            🔄 再玩一次
        </button>

    </div>


    <!-- 敗北 -->
    <div id="lose" class="card hidden">

        <div class="win">
            😭 你輸了
        </div>

        <p id="loseText" class="small"></p>

        <button onclick="location.reload()">
            🔄 再玩一次
        </button>

    </div>

</div>


<!-- Firebase -->
<script type="module">

import { initializeApp }
from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";

import {
    getDatabase,
    ref,
    set,
    update,
    onValue,
    push,
    get
}
from "https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js";


/* =====================================================
   🔥 把你的 Firebase 設定貼在這裡
   ===================================================== */

const firebaseConfig = {

    apiKey: "請貼你的 API KEY",

    authDomain: "請貼你的 AUTH DOMAIN",

    databaseURL: "請貼你的 DATABASE URL",

    projectId: "請貼你的 PROJECT ID",

    storageBucket: "請貼你的 STORAGE BUCKET",

    messagingSenderId: "請貼你的 SENDER ID",

    appId: "請貼你的 APP ID"

};


/* =====================================================
   Firebase 初始化
   ===================================================== */

const app = initializeApp(firebaseConfig);

const db = getDatabase(app);


/* =====================================================
   遊戲變數
   ===================================================== */

let roomId = "";

let playerId = "";

let opponentId = "";

let mySecret = "";

let roomData = null;


/* =====================================================
   工具
   ===================================================== */

function randomRoomCode() {

    const chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";

    let result = "";

    for (let i = 0; i < 6; i++) {

        result += chars[
            Math.floor(Math.random() * chars.length)
        ];

    }

    return result;
}


function show(id) {

    document.getElementById(id)
        .classList.remove("hidden");

}


function hide(id) {

    document.getElementById(id)
        .classList.add("hidden");

}


/* =====================================================
   建立房間
   ===================================================== */

window.createRoom = async function() {

    const input =
        document.getElementById("roomInput");

    let code =
        input.value.trim().toUpperCase();

    if (!code) {

        code = randomRoomCode();

    }

    if (code.length < 4) {

        document.getElementById("homeError")
            .innerText = "房間碼至少 4 個字元";

        return;

    }

    roomId = code;

    playerId = "player1";

    const roomRef =
        ref(db, "rooms/" + roomId);

    const snapshot =
        await get(roomRef);

    if (snapshot.exists()) {

        document.getElementById("homeError")
            .innerText = "這個房間已存在，請換一個房間碼";

        return;

    }

    await set(roomRef, {

        player1: {

            connected: true,

            ready: false,

            secret: "",

            history: []

        },

        player2: {

            connected: false,

            ready: false,

            secret: "",

            history: []

        },

        turn: "player1",

        winner: ""

    });

    document.getElementById("roomCodeDisplay")
        .innerText = roomId;

    hide("home");

    show("waiting");

    listenRoom();

};


/* =====================================================
   加入房間
   ===================================================== */

window.joinRoom = async function() {

    const input =
        document.getElementById("roomInput");

    roomId =
        input.value.trim().toUpperCase();

    if (!roomId) {

        document.getElementById("homeError")
            .innerText = "請輸入房間碼";

        return;

    }

    const roomRef =
        ref(db, "rooms/" + roomId);

    const snapshot =
        await get(roomRef);

    if (!snapshot.exists()) {

        document.getElementById("homeError")
            .innerText = "找不到這個房間";

        return;

    }

    const data = snapshot.val();

    if (data.player2.connected) {

        document.getElementById("homeError")
            .innerText = "房間已經有兩位玩家";

        return;

    }

    playerId = "player2";

    await update(roomRef, {

        "player2/connected": true

    });

    document.getElementById("roomCodeDisplay")
        .innerText = roomId;

    hide("home");

    show("waiting");

    listenRoom();

};


/* =====================================================
   監聽房間
   ===================================================== */

function listenRoom() {

    const roomRef =
        ref(db, "rooms/" + roomId);

    onValue(roomRef, snapshot => {

        if (!snapshot.exists()) return;

        roomData = snapshot.val();

        const p1 =
            roomData.player1;

        const p2 =
            roomData.player2;

        const count =
            (p1.connected ? 1 : 0) +
            (p2.connected ? 1 : 0);

        document.getElementById("playerCount")
            .innerText =
            count === 2
                ? "兩位玩家已加入"
                : "等待另一位玩家加入...";


        if (
            count === 2 &&
            !roomData[playerId].ready
        ) {

            hide("waiting");

            show("setup");

        }


        if (
            count === 2 &&
            p1.ready &&
            p2.ready
        ) {

            hide("waiting");

            hide("setup");

            show("game");

            updateGame();

        }

        if (roomData.winner) {

            showWinner();

        }

    });

}


/* =====================================================
   設定秘密數字
   ===================================================== */

window.setSecret = async function() {

    const inputs =
        document.querySelectorAll(
            "#setup .secret input"
        );

    let number = "";

    for (const input of inputs) {

        const value = input.value;

        if (!/^\d$/.test(value)) {

            document.getElementById("secretError")
                .innerText =
                "請輸入完整的 4 位數字";

            return;

        }

        number += value;

    }


    if (new Set(number).size !== 4) {

        document.getElementById("secretError")
            .innerText =
            "4 個數字不能重複";

        return;

    }


    mySecret = number;

    await update(
        ref(db, "rooms/" + roomId),
        {

            [playerId + "/secret"]:
                number,

            [playerId + "/ready"]:
                true

        }
    );

    hide("setup");

    show("game");

};


/* =====================================================
   計算 A B
   ===================================================== */

function calculateAB(secret, guess) {

    let A = 0;

    let B = 0;


    for (let i = 0; i < 4; i++) {

        if (secret[i] === guess[i]) {

            A++;

        }

    }


    for (let i = 0; i < 4; i++) {

        if (
            secret.includes(guess[i]) &&
            secret[i] !== guess[i]
        ) {

            B++;

        }

    }


    return {
        A,
        B
    };

}


/* =====================================================
   猜數字
   ===================================================== */

window.makeGuess = async function() {

    if (!roomData) return;

    if (roomData.turn !== playerId) {

        document.getElementById("guessError")
            .innerText =
            "現在不是你的回合";

        return;

    }


    const inputs =
        document.querySelectorAll(
            "#game .guess-box input"
        );

    let guess = "";

    for (const input of inputs) {

        if (!/^\d$/.test(input.value)) {

            document.getElementById("guessError")
                .innerText =
                "請輸入完整的 4 位數字";

            return;

        }

        guess += input.value;

    }


    if (new Set(guess).size !== 4) {

        document.getElementById("guessError")
            .innerText =
            "4 個數字不能重複";

        return;

    }


    const opponent =
        playerId === "player1"
            ? "player2"
            : "player1";


    const targetSecret =
        roomData[opponent].secret;


    const result =
        calculateAB(targetSecret, guess);


    const historyRef =
        ref(
            db,
            "rooms/" +
            roomId +
            "/" +
            playerId +
            "/history"
        );

    const newHistory =
        push(historyRef);


    await set(newHistory, {

        guess: guess,

        A: result.A,

        B: result.B,

        time: Date.now()

    });


    if (result.A === 4) {

        await update(
            ref(db, "rooms/" + roomId),
            {

                winner: playerId

            }
        );

        return;

    }


    const nextPlayer =
        playerId === "player1"
            ? "player2"
            : "player1";


    await update(
        ref(db, "rooms/" + roomId),
        {

            turn: nextPlayer

        }
    );


    inputs.forEach(input => {

        input.value = "";

    });


    document.getElementById("guessError")
        .innerText = "";

};


/* =====================================================
   更新遊戲畫面
   ===================================================== */

function updateGame() {

    if (!roomData) return;


    const opponent =
        playerId === "player1"
            ? "player2"
            : "player1";


    document.getElementById("meReady")
        .innerText =
        roomData[playerId].ready
            ? "✅"
            : "❌";


    document.getElementById("opponentReady")
        .innerText =
        roomData[opponent].ready
            ? "✅"
            : "❌";


    const myTurn =
        roomData.turn === playerId;


    document.getElementById("gameStatus")
        .innerText =
        myTurn
            ? "🎯 輪到你猜！"
            : "⏳ 等待對方猜...";
    

    document.getElementById("guessButton")
        .disabled = !myTurn;


    renderHistory();

}


/* =====================================================
   顯示猜測紀錄
   ===================================================== */

function renderHistory() {

    const history =
        roomData[playerId].history || {};


    const historyDiv =
        document.getElementById("history");


    historyDiv.innerHTML = "";


    const entries =
        Object.values(history);


    if (entries.length === 0) {

        historyDiv.innerHTML =
            '<p class="small">還沒有猜測紀錄</p>';

        return;

    }


    entries.reverse();


    entries.forEach(item => {

        const div =
            document.createElement("div");

        div.className = "result";

        div.innerHTML = `

            <span>
                🎯 ${item.guess}
            </span>

            <span>
                <span class="A">${item.A}A</span>
                <span class="B">${item.B}B</span>
            </span>

        `;

        historyDiv.appendChild(div);

    });

}


/* =====================================================
   顯示勝負
   ===================================================== */

function showWinner() {

    const winner =
        roomData.winner;


    hide("game");

    hide("setup");

    hide("waiting");


    if (winner === playerId) {

        show("win");

        document.getElementById("winText")
            .innerText =
            "恭喜你猜中對方的 4 位數字！";

    } else {

        show("lose");

        const opponent =
            playerId === "player1"
                ? "player2"
                : "player1";


        document.getElementById("loseText")
            .innerText =
            "對方已經猜中你的秘密數字！";

    }

}


/* =====================================================
   複製房間碼
   ===================================================== */

window.copyRoomCode = function() {

    navigator.clipboard.writeText(roomId);

    alert("房間碼已複製：" + roomId);

};


/* =====================================================
   手機輸入自動跳下一格
   ===================================================== */

document.addEventListener(
    "input",
    function(e) {

        if (
            e.target.tagName !== "INPUT"
        ) return;


        if (
            e.target.maxLength !== 1
        ) return;


        if (
            e.target.value.length === 1
        ) {

            const inputs =
                [...document.querySelectorAll(
                    "input"
                )];

            const index =
                inputs.indexOf(e.target);


            if (
                index >= 0 &&
                inputs[index + 1]
            ) {

                inputs[index + 1].focus();

            }

        }

    }
);

</script>

</body>
</html>
